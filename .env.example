# Copy optional settings into data/private/.env. The launcher creates random local keys.
# Never commit your real .env file or use NEXT_PUBLIC_* for secrets.
# API_TOKEN and SESSION_SECRET must each contain at least 32 random characters.
# API_TOKEN=
# SESSION_SECRET=

# Optional official provider credentials (the core app needs no API key):
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=
OPENAI_API_KEY=

# Optional future private PostgreSQL/Supabase direct connection:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# SQLite is used automatically when DATABASE_URL is omitted.
